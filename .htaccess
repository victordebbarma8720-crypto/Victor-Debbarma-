# SitarliveAgency.in — clean URL support for canonical/sitemap URLs
# Serves e.g. /sitarlive-agency using the sitarlive-agency.html file,
# and redirects direct .html requests to the clean URL.

RewriteEngine On

# Redirect example.com/page.html -> example.com/page (skip index.html)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteRule ^ /%1 [R=301,L]

# Internally serve the .html file for the clean URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Custom error pages fall back to homepage
ErrorDocument 404 /index.html

# Basic caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
